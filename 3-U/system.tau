// System description: interface and class contracts fixed until reboot.
// Concrete ELF modules and their dependencies are declared separately.

// Resources are described from the interface user's perspective.
// `producer` and `consumer` name the user's side of an SPSC ring buffer.
// AF_XDP style
interface PacketLink {
    // `fill` is a hint and can be omitted
    fill: producer { offset: 0, size: 2 },
    receive: consumer { offset: 2, size: 2 },
    transmit: producer { offset: 4, size: 2 },
    complete: consumer { offset: 6, size: 2 },
    umem: region { offset: 8, size: 64, readonly: false },

    send: call { slot: 0, in: 0, out: 0 },  // doorbell

    // we shouldn't have this
    // instead we should have global `wait` of all or any subset of
    // channels that the caller's role context has access to
    // poll: call { slot: 1, in: 1, out: 1 },
}

interface NetworkInfo {
    status: region { offset: 0, size: 1, readonly: true },
}

interface Run {
    stdin: producer { offset: 0, size: 4 },
    stdout: consumer { offset: 4, size: 4 },
    // 6 is maximal number of arguments passed in registers
    main: call { slot: 0, in: 6, out: 6 },
}

class EthernetDriver {
    // role context
    worker: {
        provides PacketLink {
            offset: 0,
            slot: 0,
            limit: 1,
        },

        // slot must start at 1 or further,
        // memory offset must start at 72 or further,
        // because some slots and memory occupied by previous interface
        provides NetworkInfo {
            // probably, we should be able to omit this
            // derive `offset` and `slot` automatically
            offset: 72,
            slot: 1,
            // unlimited number of clients
            limit: 0,
        },

        // let's have here link to DTB
        access "/soc/ethernet@16030000",
        access "/soc/ethernet@16040000",
    }

    // another role context that doesn't have access to the ethernet device
    // but has access to some UART, so the driver can spawn another thread
    // the context doesn't provide any interface, but it could
    // logger: {
    //     access "/soc/serial@10000000";
    // }
}

// Applications provide the same contract regardless of what they use.
// Each concrete ELF declares its own dependencies outside this description.
class Application {
    run: {
        provides Run {
            offset: 0,
            slot: 0,
            // application can have arbitrarily many instances
            limit: 0,
        },
    }
}
