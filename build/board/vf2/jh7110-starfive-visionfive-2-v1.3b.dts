		sfctemp: tmon@120e0000 {
			compatible = "starfive,jh7110-temp";
			reg = <0x0 0x120e0000 0x0 0x10000>;
			interrupts = <81>;
			clocks = <&clkgen 130>,
			<&clkgen 129>;
			clock-names = "sense", "bus";
			resets = <&rstgen 124>,
			<&rstgen 123>;
			reset-names = "sense", "bus";
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};
		
		thermal-zones {
			cpu-thermal {
				polling-delay-passive = <250>;
				polling-delay = <15000>;
				
				thermal-sensors = <&sfctemp>;
				
				trips {
					cpu_alert0: cpu_alert0 {
						
						temperature = <85000>;
						hysteresis = <2000>;
						type = "passive";
					};
					
					cpu_crit: cpu_crit {
						
						temperature = <100000>;
						hysteresis = <2000>;
						type = "critical";
					};
				};
				
				cooling-maps {
					map0 {
						trip = <&cpu_alert0>;
						cooling-device =
						<&cpu0 (~0) (~0)>,
						<&cpu1 (~0) (~0)>,
						<&cpu2 (~0) (~0)>,
						<&cpu3 (~0) (~0)>;
					};
				};
			};
		};
		
