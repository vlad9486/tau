};

&dsi_output {
	status = "okay";
	
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		
		port@0 {
			reg = <0>;
			mipi_in: endpoint {
				remote-endpoint = <&dc_out_dpi2>;
			};
		};
		
		port@1 {
			reg = <1>;
			sf_dpi_output: endpoint {
				remote-endpoint = <&dsi_in_port>;
			};
		};
	};
};

&mipi_dsi {
	status = "okay";
	
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			
			dsi0_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&panel_out0>;
			};
			
			dsi1_output: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&panel_out1>;
			};
			
		};
		
		port@1{
			reg = <1>;
			dsi_in_port: endpoint {
				remote-endpoint = <&sf_dpi_output>;
			};
		};
		
	};
};

&mipi_dphy {
	status = "okay";
};

&co_process {
	memory-region = <&e24_mem>;
	status = "okay";
};

&usbdrd30 {
	clocks = <&clkgen 95>,
	<&clkgen 196>,
	<&clkgen 194>,
	<&clkgen 195>,
	<&clkgen 191>,
	<&clkgen 193>,
	<&clkgen 192>;
	clock-names = "125m","app","lpm","stb","apb","axi","utmi";
	resets = <&rstgen 138>,
	<&rstgen 136>,
	<&rstgen 135>,
	<&rstgen 137>;
	reset-names = "pwrup","apb","axi","utmi";
	starfive,usb2-only;
	dr_mode = "peripheral";
	status = "okay";
};

&ptc {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_pins>;
	status = "okay";
};

&sof_dsp {
	memory-region = <&hifi4_reserved>;
};

&qspi {
	nor_flash: nor-flash@0 {
		compatible = "jedec,spi-nor";
		reg=<0>;
		cdns,read-delay = <3>;
		spi-max-frequency = <100000000>;
		cdns,tshsl-ns = <1>;
		cdns,tsd2d-ns = <1>;
		cdns,tchsh-ns = <1>;
		cdns,tslch-ns = <1>;
		status = "okay";
		
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			
			spl@0 {
				reg = <0x0 0x40000>;
			};
			uboot-env@100000 {
				reg = <0xf0000 0x10000>;
			};
			uboot@100000 {
				reg = <0x100000 0x300000>;
			};
			data@f00000 {
				reg = <0xf00000 0x100000>;
			};
		};
	};
};
# 9 "build/dts-vf2/jh7110-starfive-visionfive-2-v1.3b.dts" 2
# 1 "build/dts-vf2/codecs/sf_hdmi.dtsi" 1
&sound1 {
	
	simple-audio-card,dai-link@0 {
		reg = <0>;
		format = "i2s";
		bitclock-master = <&sndi2s0>;
		frame-master = <&sndi2s0>;
		mclk-fs = <256>;
		status = "okay";
		
		sndi2s0: cpu {
			sound-dai = <&i2stx_4ch0>;
		};
		
		sndhdmi0: codec {
			sound-dai = <&hdmi>;
		};
	};
};
# 10 "build/dts-vf2/jh7110-starfive-visionfive-2-v1.3b.dts" 2

/ {
	model = "StarFive VisionFive V2";
	compatible = "starfive,visionfive-v2", "starfive,jh7110";
	
	gpio-restart {
		compatible = "gpio-restart";
		gpios = <&gpio 35 0>;
		priority = <160>;
	};
	
};

&gpio {
	uart0_pins: uart0-pins {
		uart0-pins-tx {
			starfive,pins = <5>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | ((3 << 0x1U) & 0x6U)) & 0xFF)>;
			starfive,pin-gpio-dout = <20>;
			starfive,pin-gpio-doen = <0>;
		};
		
		uart0-pins-rx {
			starfive,pins = <6>;
			starfive,pinmux = <(0x2b0U) 0x0U 0x3U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | ((1 << 0x3U) & 0x8U)) & 0xFF)>;
			starfive,pin-gpio-doen = <1>;
			starfive,pin-gpio-din = <14>;
		};
	};
	
	i2c2_pins: i2c2-pins {
		i2c2-pins-scl {
			starfive,pins = <3>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
			starfive,pin-gpio-dout = <0>;
			starfive,pin-gpio-doen = <30>;
			starfive,pin-gpio-din = <59>;
		};
		
		i2c2-pins-sda {
			starfive,pins = <2>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
			starfive,pin-gpio-dout = <0>;
			starfive,pin-gpio-doen = <31>;
			starfive,pin-gpio-din = <60>;
		};
	};
	
	mmc0_pins: mmc0-pins {
		mmc0-pins-rest {
			starfive,pins = <62>;
			starfive,pinmux = <(0x2acU) 0x1BU 0x38000000U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
			starfive,pin-gpio-dout = <19>;
			starfive,pin-gpio-doen = <0>;
		};
		
		mmc0-pins-cLK {
			starfive,pins = <64>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((2 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
		};
		
		mmc0-pins-cmd {
			starfive,pins = <65>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
		};
		
		mmc0-pins-data0 {
			starfive,pins = <66>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
		};
		
		mmc0-pins-data1 {
			starfive,pins = <67>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
		};
		
		mmc0-pins-data2 {
			starfive,pins = <68>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
		};
		
		mmc0-pins-data3 {
			starfive,pins = <69>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
		};
		
		mmc0-pins-data4 {
			starfive,pins = <70>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
		};
		
		mmc0-pins-data5 {
			starfive,pins = <71>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
		};
		
		mmc0-pins-data6 {
			starfive,pins = <72>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
		};
		
		mmc0-pins-data7 {
			starfive,pins = <73>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
		};
	};
	
	sdcard1_pins: sdcard1-pins {
		sdcard1-pins0 {
			starfive,pins = <10>;
			starfive,pinmux = <(0x29cU) 0x2U 0x1CU 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((2 << 0x1U) & 0x6U) | ((1 << 0x5U) & 0x20U)) & 0xFF)>;
			starfive,pin-gpio-dout = <55>;
			starfive,pin-gpio-doen = <0>;
		};
		
		sdcard1-pins1 {
			starfive,pins = <9>;
			starfive,pinmux = <(0x2b0U) 0x8U 0x700U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
			starfive,pin-gpio-dout = <57>;
			starfive,pin-gpio-doen = <19>;
			starfive,pin-gpio-din = <44>;
		};
		
		sdcard1-pins2 {
			starfive,pins = <11>;
			starfive,pinmux = <(0x29cU) 0x5U 0xE0U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
			starfive,pin-gpio-dout = <58>;
			starfive,pin-gpio-doen = <20>;
			starfive,pin-gpio-din = <45>;
		};
		
		sdcard1-pins3 {
			starfive,pins = <12>;
			starfive,pinmux = <(0x29cU) 0x8U 0x700U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
			starfive,pin-gpio-dout = <59>;
			starfive,pin-gpio-doen = <21>;
			starfive,pin-gpio-din = <46>;
		};
		
		sdcard1-pins4 {
			starfive,pins = <7>;
			starfive,pinmux = <(0x2b0U) 0x2U 0x1CU 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
			starfive,pin-gpio-dout = <60>;
			starfive,pin-gpio-doen = <22>;
			starfive,pin-gpio-din = <47>;
		};
		
		sdcard1-pins5 {
			starfive,pins = <8>;
			starfive,pinmux = <(0x2b0U) 0x5U 0xE0U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U)) | ((1 << 0x1U) & 0x6U)) & 0xFF)>;
			starfive,pin-gpio-dout = <61>;
			starfive,pin-gpio-doen = <23>;
			starfive,pin-gpio-din = <48>;
		};
	};
	
	inno_hdmi_pins: inno_hdmi-pins {
		inno_hdmi-scl {
			starfive,pins = <0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
			starfive,pin-gpio-dout = <11>;
			starfive,pin-gpio-doen = <3>;
			starfive,pin-gpio-din = <6>;
		};
		
		inno_hdmi-sda {
			starfive,pins = <1>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
			starfive,pin-gpio-dout = <12>;
			starfive,pin-gpio-doen = <4>;
			starfive,pin-gpio-din = <7>;
		};
		inno_hdmi-cec-pins {
			starfive,pins = <14>;
			
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U) | (((1 << 0x3U) & 0x8U))) & 0xFF)>;
			starfive,pin-gpio-doen = <2>;
			starfive,pin-gpio-dout = <10>;
			starfive,pin-gpio-din = <5>;
		};
		inno_hdmi-hpd-pins {
			starfive,pins = <15>;
			
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
			starfive,pin-gpio-doen = <1>;
			starfive,pin-gpio-din = <8>;
		};
	};
	
	mclk_ext_pins: mclk_ext_pins {
		mclk_ext_pins {
			starfive,pins = <4>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
			starfive,pin-gpio-din = <30>;
			starfive,pin-gpio-doen = <1>;
		};
	};
	
	tdm0_pins: tdm0-pins {
		tdm0-pins-tx {
			starfive,pins = <44>;
			starfive,pinmux = <(0x2a8U) 0x9U 0xE00U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
			starfive,pin-gpio-dout = <41>;
			starfive,pin-gpio-doen = <0>;
		};
		
		tdm0-pins-rx {
			starfive,pins = <61>;
			starfive,pinmux = <(0x2acU) 0x18U 0x7000000U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
			starfive,pin-gpio-doen = <1>;
			starfive,pin-gpio-din = <36>;
		};
		
		tdm0-pins-sync {
			starfive,pins = <63>;
			starfive,pinmux = <(0x2acU) 0x1EU 0xC0000000U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
			starfive,pin-gpio-doen = <1>;
			starfive,pin-gpio-din = <37>;
		};
		
		tdm0-pins-pcmclk {
			starfive,pins = <38>;
			starfive,pinmux = <(0x2a4U) 0x17U 0x3800000U 0>;
			starfive,pin-ioconfig = <((((1 << 0x0U) & 0x1U)) & 0xFF)>;
			starfive,pin-gpio-doen = <1>;
			starfive,pin-gpio-din = <35>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	status = "okay";
};

&sdio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0_pins>;
	status = "okay";
};

&sdio1 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdcard1_pins>;
	
	status = "okay";
};

&hdmi {
	pinctrl-names = "default";
	pinctrl-0 = <&inno_hdmi_pins>;
	hpd-gpio = <&gpio 15 0>;
	status = "okay";
};

&i2stx_4ch0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mclk_ext_pins>;
	status = "okay";
};

&cpu1 {
	cpu-supply = <&cpu_vdd>;
	clocks = <&clkgen 1>;
	clock-names = "cpu";
};

&tdm {
	pinctrl-names = "default";
	pinctrl-0 = <&tdm0_pins>;
	status = "disabled";
};
